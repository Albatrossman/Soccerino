# =========================================================================
# Android Studio & Gradle
#
# Files and directories created by the build system or the IDE.
# =========================================================================

# Build files and output directories
/build
/.gradle

# Local configuration file (contains SDK path and other user-specific settings)
/local.properties

# Module-specific configuration files (generated by the IDE)
*.iml

# IDE project files and settings
# Generally, the entire .idea folder is ignored, but some files can be
# shared for consistent team settings.
# For simplicity and to avoid merge conflicts, ignoring most is a safe bet.
.idea/
.idea/caches
.idea/gradle.xml
.idea/misc.xml
.idea/modules.xml
.idea/runConfigurations/
.idea/libraries/
.idea/vcs.xml
.idea/workspace.xml
.idea/deploymentTargetDropDown.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# =========================================================================
# Generated Files
#
# Files generated during the build process or by development tools.
# =========================================================================

# Compiled application packages
*.apk
*.aab

# Output metadata file generated when building an AAB
/output-metadata.json

# Files for capturing memory allocation
*.hprof
*.prof

# Android Studio's Profiler snapshots
*.snapshot

# Log files
*.log

# Screenshot captures from Android Studio
captures/

# Folders for native code builds (CMake/ndk-build)
.cxx/
.externalNativeBuild/

# =========================================================================
# Sensitive & Private Files
#
# These files should never be committed to version control.
# =========================================================================

# Signing keys
*.jks
*.keystore

# Google Services file (can contain API keys and project identifiers)
# Note: In some open-source projects, a sample or placeholder file might be committed.
# However, the actual file with project keys should be ignored.
google-services.json

# =========================================================================
# Operating System Files
#
# Files generated by the operating system that are not part of the project.
# =========================================================================

# macOS
.DS_Store